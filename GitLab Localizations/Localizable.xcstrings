    "This %@ account will be removed immediatly. You can't undo this action." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses %@-Konto wird sofort entfernt. Sie können diese Aktion nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο λογαριασμός %@ θα καταργηθεί αμέσως. Δεν μπορείτε να αναιρέσετε αυτήν την ενέργεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta %@ se eliminará de inmediato. No es posible deshacer esta acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte %@ sera immédiatement supprimé. Vous ne pouvez pas annuler cette action."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ खाता तुरंत हटा दिया जाएगा। आप इस कार्रवाई को पूर्ववत नहीं कर सकते।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit %@-account wordt onmiddellijk verwijderd. U kunt deze actie niet ongedaan maken."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот аккаунт %@ будет немедленно удален. Вы не сможете отменить это действие."
